# ─── Google Cloud ───────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# Path to service account JSON key (local dev only; use Workload Identity on Cloud Run)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─── Gemini / Vertex AI ─────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash-001
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=1024

# ─── Firestore ──────────────────────────────────────────────────────────────────
FIRESTORE_COLLECTION_CUSTOMERS=customers

# ─── Twilio ─────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── App ────────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
# Public URL exposed by ngrok / Cloud Run (used to build TwiML callback URLs)
PUBLIC_BASE_URL=https://your-public-url.example.com

# ─── Audio ──────────────────────────────────────────────────────────────────────
# Twilio Media Streams use µ-law 8kHz; Gemini expects linear16 16kHz
AUDIO_SAMPLE_RATE_IN=8000
AUDIO_SAMPLE_RATE_OUT=8000
# Silence threshold for barge-in detection (0-32768)
BARGE_IN_ENERGY_THRESHOLD=300
# Consecutive silent frames before we consider speech ended
BARGE_IN_SILENCE_FRAMES=20
