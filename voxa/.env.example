# ─── Google Cloud ───────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# Local dev only; on Cloud Run use the attached service account (leave unset)
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Gemini (Vertex AI) ─────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=256

# ─── Voice engine ───────────────────────────────────────────────────────────────
# live = Gemini Live native audio (lowest latency); cascade = STT → Gemini → TTS (also the automatic fallback)
VOICE_ENGINE=live
LIVE_MODEL=gemini-live-2.5-flash-native-audio
LIVE_VOICE=Aoede
LIVE_LANGUAGE_CODE=fr-FR

# ─── Call policy ────────────────────────────────────────────────────────────────
MAX_CALL_SECONDS=900
GOODBYE_GRACE_SECONDS=8
# Withhold account data until the caller passes verify_caller (date of birth in Firestore: birth_date)
REQUIRE_CALLER_VERIFICATION=false
MAX_VERIFICATION_ATTEMPTS=3
FIRESTORE_COLLECTION_ESCALATIONS=escalations

# ─── Speech (cascade engine) ──────────────────────────────────────────────────────────────────────
STT_LANGUAGE_CODE=fr-FR
TTS_LANGUAGE_CODE=fr-FR
TTS_VOICE_NAME=fr-FR-Neural2-A

# ─── Firestore ──────────────────────────────────────────────────────────────────
FIRESTORE_COLLECTION_CUSTOMERS=customers

# ─── Twilio ─────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
VALIDATE_TWILIO_SIGNATURE=true

# ─── App ────────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
# Public URL of the service (ngrok / Cloud Run), no trailing slash
PUBLIC_BASE_URL=https://your-public-url.example.com

# ─── Barge-in ───────────────────────────────────────────────────────────────────
# RMS energy (16-bit PCM) above which a 20 ms frame counts as caller speech
BARGE_IN_ENERGY_THRESHOLD=500
# Consecutive loud frames needed (3 × 20 ms = 60 ms) before interrupting TTS
BARGE_IN_MIN_FRAMES=3
# Characters an interim transcript needs before it may interrupt (filters 'mm', 'ah')
BARGE_IN_MIN_CHARS=3
